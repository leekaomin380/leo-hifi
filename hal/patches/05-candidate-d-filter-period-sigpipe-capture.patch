diff --git a/hal/audio_hw.c b/hal/audio_hw.c
index 04409a7..d1b4709 100644
--- a/hal/audio_hw.c
+++ b/hal/audio_hw.c
@@ -168,6 +168,79 @@ struct pcm_config pcm_config_afe_proxy_record = {
     .avail_min = AFE_PROXY_RECORD_PERIOD_SIZE,
 };
 
+#ifdef LEO_HIFI_ENABLED
+#include <fcntl.h>
+#include <signal.h>
+#include <unistd.h>
+/*
+ * Candidate D (all read once in adev_open, i.e. per audioserver start):
+ *   D1  persist.vendor.leo.audio.deep_period  deep-buffer period in frames;
+ *       960..3840 and a multiple of 960, otherwise ignored (stock 960).
+ *   D4  ignore SIGPIPE when it is still SIG_DFL: the effects HAL hosted in
+ *       this process dprintf()s into dumpsys pipes and was killed by a
+ *       truncated `dumpsys media.audio_flinger | head`.
+ *   A   vendor.leo.audio.capture_bytes  debug tap: copy the first N bytes
+ *       handed to pcm_write on the deep-buffer stream into
+ *       /data/vendor/audio/leo-capture.raw (raw S16_LE). Off when unset.
+ */
+#define LEO_CAPTURE_PATH "/data/vendor/audio/leo-capture.raw"
+static int leo_cap_fd = -1;
+static size_t leo_cap_left;
+
+static void leo_candidate_d_init(void)
+{
+    char value[PROPERTY_VALUE_MAX];
+    struct sigaction sa;
+    int trial;
+
+    if (property_get("persist.vendor.leo.audio.deep_period", value, NULL) > 0) {
+        trial = atoi(value);
+        if (trial >= DEEP_BUFFER_OUTPUT_PERIOD_SIZE &&
+            trial <= 4 * DEEP_BUFFER_OUTPUT_PERIOD_SIZE &&
+            trial % DEEP_BUFFER_OUTPUT_PERIOD_SIZE == 0) {
+            pcm_config_deep_buffer.period_size = trial;
+            pcm_config_deep_buffer.start_threshold = trial / 4;
+            pcm_config_deep_buffer.avail_min = trial / 4;
+            ALOGI("leo: deep-buffer period %d frames x %d", trial,
+                  pcm_config_deep_buffer.period_count);
+        } else {
+            ALOGW("leo: ignoring deep_period=%s", value);
+        }
+    }
+
+    if (sigaction(SIGPIPE, NULL, &sa) == 0 && sa.sa_handler == SIG_DFL) {
+        signal(SIGPIPE, SIG_IGN);
+        ALOGI("leo: SIGPIPE ignored in the HAL service process");
+    }
+
+    if (property_get("vendor.leo.audio.capture_bytes", value, NULL) > 0) {
+        long n = atol(value);
+        if (n > 0 && n <= 64L * 1024 * 1024) {
+            leo_cap_fd = open(LEO_CAPTURE_PATH, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+            leo_cap_left = leo_cap_fd >= 0 ? (size_t)n : 0;
+            ALOGI("leo: capture %ld bytes -> %s (fd %d)", n, LEO_CAPTURE_PATH, leo_cap_fd);
+        }
+    }
+}
+
+static void leo_capture(const void *buffer, size_t bytes)
+{
+    size_t n;
+    ssize_t w;
+
+    if (leo_cap_fd < 0)
+        return;
+    n = bytes < leo_cap_left ? bytes : leo_cap_left;
+    w = write(leo_cap_fd, buffer, n);
+    leo_cap_left = w == (ssize_t)n ? leo_cap_left - n : 0;
+    if (leo_cap_left == 0) {
+        close(leo_cap_fd);
+        leo_cap_fd = -1;
+        ALOGI("leo: capture finished");
+    }
+}
+#endif
+
 const char * const use_case_table[AUDIO_USECASE_MAX] = {
     [USECASE_AUDIO_PLAYBACK_DEEP_BUFFER] = "deep-buffer-playback",
     [USECASE_AUDIO_PLAYBACK_LOW_LATENCY] = "low-latency-playback",
@@ -2577,8 +2650,10 @@ static ssize_t out_write(struct audio_stream_out *stream, const void *buffer,
 
 #ifdef LEO_HIFI_ENABLED
             /* Capture before the blocking write. A route change invalidates this token. */
-            if (out->usecase == USECASE_AUDIO_PLAYBACK_DEEP_BUFFER)
+            if (out->usecase == USECASE_AUDIO_PLAYBACK_DEEP_BUFFER) {
                 leo_token = platform_leo_hifi_flow_token(adev->platform, (uintptr_t)out);
+                leo_capture(buffer, bytes);
+            }
 #endif
             if (out->usecase == USECASE_AUDIO_PLAYBACK_AFE_PROXY)
                 ret = pcm_mmap_write(out->pcm, (void *)buffer, bytes);
@@ -4268,6 +4343,9 @@ static int adev_open(const hw_module_t *module, const char *name,
             configured_low_latency_capture_period_size = trial;
         }
     }
+#ifdef LEO_HIFI_ENABLED
+    leo_candidate_d_init();
+#endif
 
     adev->multi_offload_enable = property_get_bool("vendor.audio.offload.multiple.enabled", false);
     pthread_mutex_unlock(&adev_init_lock);
diff --git a/hal/msm8974/leo_hifi.c b/hal/msm8974/leo_hifi.c
index a03de70..28df44f 100644
--- a/hal/msm8974/leo_hifi.c
+++ b/hal/msm8974/leo_hifi.c
@@ -123,6 +123,7 @@ static bool leo_probe(struct leo_hifi *lh)
      * before a route change rather than half-way through one.
      */
     lh->ctl_volume        = leo_ctl(lh, "Volume");
+    lh->ctl_filter        = leo_ctl_opt(lh, "Filter Shape");
     lh->ctl_quat_bw       = leo_ctl(lh, "QUAT_MI2S BitWidth");
     lh->ctl_quat_sr       = leo_ctl(lh, "QUAT_MI2S SampleRate");
     lh->ctl_hphl_dac      = leo_ctl(lh, "HPHL DAC Switch");
@@ -180,6 +181,15 @@ void leo_hifi_init(struct leo_hifi *lh, struct mixer *mixer,
     lh->mixer = mixer;
     lh->device_name = device_table_name;
 
+    /* Candidate D: filter wanted on HiFi entry.  Only the three driver
+     * strings are accepted; anything else (including "keep") writes nothing. */
+    property_get(LEO_PROP_FILTER, value, LEO_HIFI_FILTER_DEFAULT);
+    if (strcmp(value, "Fast Rolloff") == 0 || strcmp(value, "Slow Rolloff") == 0 ||
+        strcmp(value, "Minimum Phase") == 0)
+        strlcpy(lh->filter_want, value, sizeof(lh->filter_want));
+    else
+        lh->filter_want[0] = '\0';
+
     (void) leo_probe(lh);
 
     /* Policy intent.  Default OFF: an untouched device behaves like stock. */
@@ -767,6 +777,28 @@ static void leo_hifi_fallback(struct leo_hifi *lh)
           __func__, lh->generation, lh->fail_code, lh->evidence, lh->bypass);
 }
 
+/* Candidate D: put the ES9018 digital filter back to the wanted shape.  The
+ * driver resets it to Minimum Phase whenever it re-initialises (seen after an
+ * audioserver restart).  Advisory only: a missing control or a failed write is
+ * logged and never touches fail_code or the HiFi state. */
+static void leo_hifi_apply_filter(struct leo_hifi *lh)
+{
+    const char *got;
+    int idx;
+
+    if (lh->ctl_filter == NULL || lh->filter_want[0] == '\0')
+        return;
+    idx = mixer_ctl_get_value(lh->ctl_filter, 0);
+    got = (idx >= 0) ? mixer_ctl_get_enum_string(lh->ctl_filter, (unsigned int)idx) : NULL;
+    if (got != NULL && strcmp(got, lh->filter_want) == 0)
+        return;
+    if (mixer_ctl_set_enum_by_string(lh->ctl_filter, lh->filter_want) != 0) {
+        ALOGW("%s: 'Filter Shape' <- '%s' failed", __func__, lh->filter_want);
+        return;
+    }
+    ALOGI("%s: 'Filter Shape' %s -> %s", __func__, got ? got : "(null)", lh->filter_want);
+}
+
 void leo_hifi_on_route(struct leo_hifi *lh, bool to_hifi_device)
 {
     int vol[2];
@@ -863,6 +895,7 @@ void leo_hifi_on_route(struct leo_hifi *lh, bool to_hifi_device)
         }
     }
     lh->vol_applied = true;
+    leo_hifi_apply_filter(lh);
     lh->effective = LEO_HIFI_ACTIVE;
     ALOGI("%s: gen=%llu evidence=0x%x bypass=0x%x -> hifi_active",
           __func__, lh->generation, lh->evidence, lh->bypass);
diff --git a/hal/msm8974/leo_hifi.h b/hal/msm8974/leo_hifi.h
