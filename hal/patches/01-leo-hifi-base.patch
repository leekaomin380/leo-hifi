diff --git a/hal/Android.mk b/hal/Android.mk
index 7eca4aa..923d079 100644
--- a/hal/Android.mk
+++ b/hal/Android.mk
@@ -49,6 +49,20 @@ LOCAL_SRC_FILES += audio_extn/audio_extn.c \
 
 LOCAL_CFLAGS += -DUSE_VENDOR_EXTN
 
+# Leo (Xiaomi Mi Note Pro) HiFi controller: ES9018K2M over QUAT_MI2S.
+#
+# Opt-in per device: set AUDIO_FEATURE_ENABLED_LEO_HIFI := true in the device
+# BoardConfig.  Every other target -- including the other msm8974-platform
+# boards that share this source file -- builds byte-identical to upstream.
+# The inner guard keeps the build honest if the flag is ever set on a board
+# whose AUDIO_PLATFORM is not msm8974.
+ifeq ($(strip $(AUDIO_FEATURE_ENABLED_LEO_HIFI)),true)
+ifeq ($(strip $(AUDIO_PLATFORM)),msm8974)
+    LOCAL_SRC_FILES += $(AUDIO_PLATFORM)/leo_hifi.c
+    LOCAL_CFLAGS += -DLEO_HIFI_ENABLED
+endif
+endif
+
 ifneq ($(filter msm8994 msm8992,$(TARGET_BOARD_PLATFORM)),)
     LOCAL_SRC_FILES += edid.c
 endif
