+
+#define LOG_TAG "leo_hifi"
+/*#define LOG_NDEBUG 0*/
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+#include <log/log.h>
+#include <cutils/properties.h>
+
+#include "leo_hifi.h"
+
+/*
+ * sysfs proof that the ES9018 codec driver bound to I2C 6-0048.
+ * Overridable so that the host-side fault-injection harness can point it at a
+ * temporary path; the device build never defines it.
+ */
+#ifndef LEO_ESS_SYSFS_DRIVER
+#define LEO_ESS_SYSFS_DRIVER "/sys/bus/i2c/devices/6-0048/driver"
+#endif
+
+/*
+ * Resolve one control.  A missing control is a probe failure, but a
+ * *retryable* one: the codec component may simply not have bound yet.
+ */
+static struct mixer_ctl *leo_ctl(struct leo_hifi *lh, const char *name)
+{
+    struct mixer_ctl *ctl = mixer_get_ctl_by_name(lh->mixer, name);
+
+    if (ctl == NULL) {
+        ALOGW("%s: mixer control '%s' not found", __func__, name);
+        lh->supported = false;
+        lh->fail_code = LEO_FAIL_CTL_MISSING;
+    }
+    return ctl;
+}
+
+/* Optional control: absence is recorded, not a failure. */
+static struct mixer_ctl *leo_ctl_opt(struct leo_hifi *lh, const char *name)
+{
+    struct mixer_ctl *ctl = mixer_get_ctl_by_name(lh->mixer, name);
+
+    if (ctl == NULL)
+        ALOGV("%s: optional mixer control '%s' absent", __func__, name);
+    return ctl;
+}
+
+static bool leo_ess_bound(void)
+{
+    struct stat st;
+
+    /* stat() follows the symlink; ENOENT means the driver never bound. */
+    return (stat(LEO_ESS_SYSFS_DRIVER, &st) == 0);
+}
+
+/*
+ * Read-only probe.  Writes nothing, so it is safe to call again later.
+ * Returns lh->supported.
+ */
+static bool leo_probe(struct leo_hifi *lh)
+{
+    char ctl_name[64];
+    int i;
+
+    lh->probe_attempts++;
+    lh->supported = true;
+    lh->fail_code = LEO_FAIL_NONE;
+
+    if (lh->mixer == NULL) {
+        ALOGE("%s: no mixer handle", __func__);
+        lh->supported = false;
+        lh->permanent_fail = true;
+        lh->fail_code = LEO_FAIL_CTL_MISSING;
+        return false;
+    }
+
+    /*
+     * Structural self-check.  If the device table no longer maps our symbol to
+     * the mixer_paths.xml path name we do not know which device we would be
+     * enabling, so HiFi is disabled permanently rather than degraded.  This is
+     * the one failure class that is never retried: it cannot fix itself.
+     */
+    if (lh->device_name == NULL ||
+        strcmp(lh->device_name, LEO_HIFI_DEVICE_NAME) != 0) {
+        ALOGE("%s: device_table mismatch ('%s' != '%s'); HiFi disabled for good",
+              __func__, lh->device_name ? lh->device_name : "(null)",
+              LEO_HIFI_DEVICE_NAME);
+        lh->supported = false;
+        lh->permanent_fail = true;
+        lh->fail_code = LEO_FAIL_TABLE_MISMATCH;
+        return false;
+    }
+
+    if (!leo_ess_bound()) {
+        ALOGW("%s: %s absent; ES9018 not bound (attempt %d/%d)", __func__,
+              LEO_ESS_SYSFS_DRIVER, lh->probe_attempts, LEO_HIFI_PROBE_MAX);
+        lh->supported = false;
+        lh->fail_code = LEO_FAIL_ESS_UNBOUND;
+        return false;
+    }
+
+    /*
+     * Resolve every control up-front so that "control missing" is discovered
+     * before a route change rather than half-way through one.
+     */
+    lh->ctl_volume        = leo_ctl(lh, "Volume");
+    lh->ctl_quat_bw       = leo_ctl(lh, "QUAT_MI2S BitWidth");
+    lh->ctl_quat_sr       = leo_ctl(lh, "QUAT_MI2S SampleRate");
+    lh->ctl_hphl_dac      = leo_ctl(lh, "HPHL DAC Switch");
+    lh->ctl_slim_rx1_mux  = leo_ctl(lh, "SLIM RX1 MUX");
+    lh->ctl_slim_rx2_mux  = leo_ctl(lh, "SLIM RX2 MUX");
+
+    /*
+     * The sound card exposes a single "HPHL DAC Switch"; the right channel is
+     * gated through the RX2 chain and CLASS_H_DSM MUX instead.  These are
+     * optional so that a card revision without them still works, but when
+     * present they widen the bypass observation to both channels.
+     */
+    lh->ctl_rx1_mix1_inp1 = leo_ctl_opt(lh, "RX1 MIX1 INP1");
+    lh->ctl_rx2_mix1_inp1 = leo_ctl_opt(lh, "RX2 MIX1 INP1");
+    lh->ctl_class_h_mux   = leo_ctl_opt(lh, "CLASS_H_DSM MUX");
+
+    for (i = 0; i < LEO_HIFI_MM_COUNT; i++) {
+        snprintf(ctl_name, sizeof(ctl_name),
+                 "SLIMBUS_0_RX Audio Mixer MultiMedia%d", i + 1);
+        lh->ctl_slim_mm[i] = leo_ctl(lh, ctl_name);
+
+        /*
+         * QUAT_MI2S_RX has no MultiMedia9 mixer on this card, so these are
+         * optional: absence of one index must not disable the controller.
+         */
+        snprintf(ctl_name, sizeof(ctl_name),
+                 "QUAT_MI2S_RX Audio Mixer MultiMedia%d", i + 1);
+        lh->ctl_quat_mm[i] = leo_ctl_opt(lh, ctl_name);
+    }
+
+    if (!lh->supported)
+        ALOGW("%s: probe %d/%d failed, fail_code=%d", __func__,
+              lh->probe_attempts, LEO_HIFI_PROBE_MAX, lh->fail_code);
+    else
+        ALOGI("%s: probe %d succeeded", __func__, lh->probe_attempts);
+
+    return lh->supported;
+}
+
+void leo_hifi_init(struct leo_hifi *lh, struct mixer *mixer,
+                   const char *device_table_name)
+{
+    char value[PROPERTY_VALUE_MAX];
+    struct timespec now;
+
+    memset(lh, 0, sizeof(*lh));
+    pthread_mutex_init(&lh->telemetry_lock, NULL);
+    if (clock_gettime(CLOCK_MONOTONIC, &now) == 0)
+        lh->session = ((unsigned long long)now.tv_sec * 1000000000ULL
+                       + (unsigned long long)now.tv_nsec) & 0x7fffffffffffffffULL;
+    leo_flow_reset(&lh->flow);
+
+    lh->effective = LEO_HIFI_IDLE;
+    lh->mixer = mixer;
+    lh->device_name = device_table_name;
+
+    (void) leo_probe(lh);
+
+    /* Policy intent.  Default OFF: an untouched device behaves like stock. */
+    if (property_get(LEO_PROP_ENABLE, value, "false") > 0)
+        lh->requested = (strcmp(value, "true") == 0);
+    else
+        lh->requested = false;
+
+    /*
+     * Volume intent is READ but deliberately NOT APPLIED here.
+     *
+     * Until runtime experiments R6 (does the Android software volume stack
+     * with this control?) and R7 (is the direction and magnitude what the
+     * kernel TLV says?) are done, the shipping default must leave the control
+     * at the mixer_paths.xml value of 205.  None of 213/225/229 may become a
+     * product default before then.  See docs/19 section 6.2.
+     */
+    if (property_get(LEO_PROP_VOLUME, value, "") > 0 && value[0] != '\0') {
+        int v = atoi(value);
+
+        if (v < 0)
+            v = 0;
+        if (v > LEO_HIFI_VOL_MAX)
+            v = LEO_HIFI_VOL_MAX;
+        lh->vol_user = v;
+    }
+    lh->vol_applied = false;
+
+    /* A service restart does not itself prove that mixer state was reset.
+     * Never replay saved gain. Recover only after the device/control probe. */
+    if (lh->supported && leo_hifi_restore_volume_floor(lh) != 0)
+        lh->effective = LEO_HIFI_ERROR_FALLBACK;
+
+    /*
+     * property_set() may fail before the vendor property_contexts entry
+     * exists (it is a device-tree change, docs/19 section 9.4).  That is not
+     * fatal: the published property is a convenience, not a control path.
+     */
+    (void) property_set(LEO_PROP_SUPPORTED, lh->supported ? "true" : "false");
+
+    ALOGI("%s: supported=%d permanent_fail=%d requested=%d vol_user=%d fail=%d",
+          __func__, lh->supported, lh->permanent_fail, lh->requested,
+          lh->vol_user, lh->fail_code);
+}
+
+bool leo_hifi_route_wanted(struct leo_hifi *lh)
+{
+    if (!lh->requested)
+        return false;
+
+    if (lh->supported)
+        return !lh->vol_restore_pending || leo_hifi_restore_volume_floor(lh) == 0;
+
+    /*
+     * Bounded, read-only late re-probe.  See LEO_HIFI_PROBE_MAX.  A failed
+     * re-probe returns the same standard device as before, so select_devices()
+     * sees no device change and does not re-route: no pop, no loop.
+     */
+    if (lh->permanent_fail || lh->probe_attempts >= LEO_HIFI_PROBE_MAX)
+        return false;
+
+    ALOGI("%s: re-probing (attempt %d of %d)", __func__,
+          lh->probe_attempts + 1, LEO_HIFI_PROBE_MAX);
+    if (leo_probe(lh)) {
+        (void) property_set(LEO_PROP_SUPPORTED, "true");
+        return leo_hifi_restore_volume_floor(lh) == 0;
+    }
+    return false;
+}
+
+void leo_hifi_ctl_to_db(int ctl_value, const char **sign, int *whole, int *tenth)
+{
+    int dq = ctl_value * 5 - 1275;      /* exact tenths of a dB */
+
+    *sign = (dq < 0) ? "-" : "";
+    if (dq < 0)
+        dq = -dq;
+    *whole = dq / 10;
+    *tenth = dq % 10;
+}
+
+int leo_hifi_read_volume(struct leo_hifi *lh, int out[2])
+{
+    if (!lh->supported || lh->ctl_volume == NULL)
+        return -ENODEV;
+
+    out[0] = mixer_ctl_get_value(lh->ctl_volume, 0);
+    out[1] = mixer_ctl_get_value(lh->ctl_volume, 1);
+    if (out[0] < 0 || out[1] < 0)
+        return -EIO;
+
+    return 0;
+}
+
+static int leo_write_volume_ctl(struct leo_hifi *lh, int ctl_value)
+{
+    int values[2];
+    int back[2] = {-1, -1};
+    const char *sign;
+    int whole, tenth;
+    int ret;
+
+    /* Hard clamp: never below the factory floor, never above the stage cap. */
+    if (ctl_value < LEO_HIFI_CTL_FLOOR)
+        ctl_value = LEO_HIFI_CTL_FLOOR;
+    if (ctl_value > LEO_HIFI_CTL_CEIL)
+        ctl_value = LEO_HIFI_CTL_CEIL;
+
+    values[0] = values[1] = ctl_value;
+    ret = mixer_ctl_set_array(lh->ctl_volume, values, 2);
+    if (ret != 0) {
+        ALOGE("%s: write %d failed (%d)", __func__, ctl_value, ret);
+        lh->fail_code = LEO_FAIL_CTL_WRITE;
+        return -EIO;
+    }
+
+    if (leo_hifi_read_volume(lh, back) != 0 ||
+        back[0] != ctl_value || back[1] != ctl_value) {
+        ALOGE("%s: read-back mismatch: wrote %d, read %d/%d",
+              __func__, ctl_value, back[0], back[1]);
+        lh->fail_code = LEO_FAIL_READBACK_SOFT;
+        return -EIO;
+    }
+
+    leo_hifi_ctl_to_db(ctl_value, &sign, &whole, &tenth);
+    ALOGI("%s: ES9018 Volume = %d (%s%d.%d dB)", __func__, ctl_value,
+          sign, whole, tenth);
+    return 0;
+}
+
+int leo_hifi_restore_volume_floor(struct leo_hifi *lh)
+{
+    int back[2];
+    int ret;
+
+    lh->vol_restore_pending = true;
+    if (!lh->supported || lh->ctl_volume == NULL)
+        return -ENODEV;
+
+    if (leo_hifi_read_volume(lh, back) == 0 &&
+        back[0] == LEO_HIFI_CTL_FLOOR && back[1] == LEO_HIFI_CTL_FLOOR)
+        ret = 0;
+    else
+        ret = leo_write_volume_ctl(lh, LEO_HIFI_CTL_FLOOR);
+
+    if (ret == 0) {
+        lh->vol_applied = false;
+        lh->vol_restore_pending = false;
+    } else {
+        lh->effective = LEO_HIFI_ERROR_FALLBACK;
+    }
+    return ret;
+}
+
+int leo_hifi_apply_volume(struct leo_hifi *lh, int user_vol)
+{
+    char buf[PROPERTY_VALUE_MAX];
+    int target, current, step;
+    int back[2];
+
+    if (!lh->supported || lh->ctl_volume == NULL)
+        return -ENODEV;
+
+    if (lh->vol_restore_pending)
+        return -EIO;
+
+    if (user_vol < 0 || user_vol > LEO_HIFI_VOL_MAX) {
+        ALOGW("%s: request %d out of [0,%d]; keeping current value",
+              __func__, user_vol, LEO_HIFI_VOL_MAX);
+        lh->fail_code = LEO_FAIL_VOL_RANGE;
+        return -EINVAL;
+    }
+
+    if (leo_hifi_read_volume(lh, back) != 0 || back[0] != back[1] ||
+        back[0] < LEO_HIFI_CTL_FLOOR || back[0] > LEO_HIFI_CTL_CEIL) {
+        lh->fail_code = LEO_FAIL_READBACK_SOFT;
+        (void) leo_hifi_restore_volume_floor(lh);
+        return -EIO;
+    }
+    current = back[0];
+    target = leo_hifi_user_to_ctl(user_vol);
+
+    /* Ramp in bounded frames so a UI drag cannot produce a jump. */
+    step = (LEO_HIFI_VOL_STEP_MAX * 2) / 5;
+    if (step < 1)
+        step = 1;
+
+    while (current != target) {
+        int next;
+
+        if (target > current)
+            next = (target - current > step) ? current + step : target;
+        else
+            next = (current - target > step) ? current - step : target;
+
+        if (leo_write_volume_ctl(lh, next) != 0) {
+            /* A failed/partial write may already have changed hardware.
+             * Keep recovery pending until BOTH channels prove the floor. */
+            (void) leo_hifi_restore_volume_floor(lh);
+            return -EIO;
+        }
+        current = next;
+        if (current != target)
+            usleep(20000);
+    }
+
+    lh->vol_user = user_vol;
+    lh->vol_applied = true;
+    snprintf(buf, sizeof(buf), "%d", user_vol);
+    (void) property_set(LEO_PROP_VOLUME, buf);
+    return 0;
+}
+
+static int leo_set_enum_checked(struct leo_hifi *lh, struct mixer_ctl *ctl,
+                                const char *ctl_name, const char *want)
+{
+    const char *got;
+    int idx;
+    int ret;
+
+    if (ctl == NULL)
+        return -ENODEV;
+
+    ret = mixer_ctl_set_enum_by_string(ctl, want);
+    if (ret != 0) {
+        ALOGE("%s: '%s' <- '%s' failed (%d)", __func__, ctl_name, want, ret);
+        lh->fail_code = LEO_FAIL_CTL_WRITE;
+        return -EIO;
+    }
+
+    idx = mixer_ctl_get_value(ctl, 0);
+    got = (idx >= 0) ? mixer_ctl_get_enum_string(ctl, (unsigned int)idx) : NULL;
+    if (got == NULL || strcmp(got, want) != 0) {
+        ALOGE("%s: '%s' read-back '%s' != '%s'", __func__, ctl_name,
+              got ? got : "(null)", want);
+        lh->fail_code = LEO_FAIL_BACKEND_READBACK;
+        return -EIO;
+    }
+
+    ALOGI("%s: '%s' = '%s' (read back)", __func__, ctl_name, want);
+    return 0;
+}
+
+int leo_hifi_set_backend(struct leo_hifi *lh)
+{
+    int ret;
+
+    if (!lh->supported)
+        return -ENODEV;
+
+    ret = leo_set_enum_checked(lh, lh->ctl_quat_bw, "QUAT_MI2S BitWidth",
+                               LEO_HIFI_BITWIDTH_STR);
+    if (ret != 0)
+        return ret;
+
+    return leo_set_enum_checked(lh, lh->ctl_quat_sr, "QUAT_MI2S SampleRate",
+                                LEO_HIFI_SAMPLERATE_STR);
+}
+
+bool leo_hifi_set_mode(struct leo_hifi *lh, bool enable)
+{
+    bool old = lh->requested;
+
+    /*
+     * The intent is recorded even when the controller is currently
+     * unsupported: a later successful re-probe should honour what the user
+     * asked for.  Route selection still refuses until a probe succeeds.
+     */
+    lh->requested = enable;
+    if (!enable && (lh->vol_applied || lh->vol_restore_pending))
+        (void) leo_hifi_restore_volume_floor(lh);
+    (void) property_set(LEO_PROP_ENABLE, enable ? "true" : "false");
+    ALOGI("%s: leo_hifi_mode %s -> %s (supported=%d)", __func__,
+          old ? "true" : "false", enable ? "true" : "false", lh->supported);
+
+    return (old != enable);
+}
+
+static const char *leo_state_name(leo_hifi_state_t s)
+{
+    switch (s) {
+    case LEO_HIFI_IDLE:            return "idle";
+    case LEO_HIFI_SPEAKER:         return "speaker";
+    case LEO_HIFI_WIRED_STANDARD:  return "wired_standard";
+    case LEO_HIFI_ARMING:          return "arming";
+    case LEO_HIFI_ACTIVE:          return "hifi_active";
+    case LEO_HIFI_DEGRADED:        return "hifi_degraded";
+    case LEO_HIFI_ERROR_FALLBACK:  return "error_fallback";
+    default:                       return "unknown";
+    }
+}
+
+/* An enum control counts as "live" when it is resolvable and not ZERO. */
+static bool leo_enum_is_live(struct mixer_ctl *ctl)
+{
+    const char *s;
+    int idx;
+
+    if (ctl == NULL)
+        return false;
+
+    idx = mixer_ctl_get_value(ctl, 0);
+    if (idx < 0)
+        return false;
+
+    s = mixer_ctl_get_enum_string(ctl, (unsigned int)idx);
+    return (s != NULL && strcmp(s, "ZERO") != 0);
+}
+
+bool leo_hifi_check_bypass(struct leo_hifi *lh)
+{
+    unsigned int bp = 0;
+    int i;
+    int v;
+
+    /* (1) digital front end feeding the WCD backend */
+    for (i = 0; i < LEO_HIFI_MM_COUNT; i++) {
+        if (lh->ctl_slim_mm[i] == NULL)
+            continue;
+        v = mixer_ctl_get_value(lh->ctl_slim_mm[i], 0);
+        if (v > 0) {
+            ALOGD("%s: SLIMBUS_0_RX Audio Mixer MultiMedia%d is On",
+                  __func__, i + 1);
+            bp |= LEO_BP_SLIM_FE;
+        }
+    }
+
+    /* (2) SLIM receive muxes, both channels */
+    if (leo_enum_is_live(lh->ctl_slim_rx1_mux) ||
+        leo_enum_is_live(lh->ctl_slim_rx2_mux))
+        bp |= LEO_BP_MUX_LIVE;
+
+    /* (3) interpolator inputs, both channels (optional controls) */
+    if (leo_enum_is_live(lh->ctl_rx1_mix1_inp1) ||
+        leo_enum_is_live(lh->ctl_rx2_mix1_inp1))
+        bp |= LEO_BP_MIX_LIVE;
+
+    /* (4) Class-H DSM mux -- this is what gates the RIGHT channel DAC */
+    if (leo_enum_is_live(lh->ctl_class_h_mux))
+        bp |= LEO_BP_CLASSH;
+
+    /* (5) the analog outlet itself: the decisive gate */
+    if (lh->ctl_hphl_dac != NULL) {
+        v = mixer_ctl_get_value(lh->ctl_hphl_dac, 0);
+        if (v > 0)
+            bp |= LEO_BP_OUTLET;
+    }
+
+    lh->bypass = bp;
+
+    if (bp & LEO_BP_FATAL_MASK) {
+        ALOGE("%s: FATAL WCD bypass: the analog outlet is open "
+              "(bypass mask 0x%x)", __func__, bp);
+        lh->fail_code = LEO_FAIL_WCD_BYPASS;
+        return false;
+    }
+
+    if (bp != 0)
+        ALOGW("%s: bypass attempt observed but the analog outlet is cut "
+              "(mask 0x%x); not audible, recorded only", __func__, bp);
+
+    return true;
+}
+
+static bool leo_quat_front_end_live(struct leo_hifi *lh)
+{
+    int i;
+    int v;
+
+    for (i = 0; i < LEO_HIFI_MM_COUNT; i++) {
+        if (lh->ctl_quat_mm[i] == NULL)
+            continue;
+        v = mixer_ctl_get_value(lh->ctl_quat_mm[i], 0);
+        if (v > 0) {
+            ALOGI("%s: QUAT_MI2S_RX Audio Mixer MultiMedia%d is On",
+                  __func__, i + 1);
+            return true;
+        }
+    }
+
+    ALOGE("%s: no QUAT_MI2S_RX front end is routed; the mixer path did not "
+          "take effect", __func__);
+    return false;
+}
+
+static void leo_hifi_fallback(struct leo_hifi *lh)
+{
+    /*
+     * Unified fallback.  Stop writing, undo what this generation wrote in
+     * reverse order, and leave the controller in a state that requires a
+     * fresh generation (and a fresh full read-back) before it may claim
+     * HIFI_ACTIVE again.
+     *
+     * The caller (enable_audio_route) is on the select_devices() path; the
+     * actual return to SND_DEVICE_OUT_HEADPHONES happens on the next route
+     * decision, which is why ERROR_FALLBACK is a terminal state until then.
+     */
+    (void) leo_hifi_set_backend(lh);
+    if (lh->vol_applied || lh->vol_restore_pending)
+        (void) leo_hifi_restore_volume_floor(lh);
+
+    lh->generation++;
+    lh->effective = LEO_HIFI_ERROR_FALLBACK;
+    ALOGE("%s: gen=%llu fail=%d evidence=0x%x bypass=0x%x -> error_fallback",
+          __func__, lh->generation, lh->fail_code, lh->evidence, lh->bypass);
+}
+
+void leo_hifi_on_route(struct leo_hifi *lh, bool to_hifi_device)
+{
+    int vol[2];
+    pthread_mutex_lock(&lh->telemetry_lock);
+    leo_flow_reset(&lh->flow);
+    pthread_mutex_unlock(&lh->telemetry_lock);
+
+    if (!to_hifi_device) {
+        if ((lh->vol_applied || lh->vol_restore_pending) &&
+            leo_hifi_restore_volume_floor(lh) != 0) {
+            lh->generation++;
+            lh->effective = LEO_HIFI_ERROR_FALLBACK;
+            return;
+        }
+        /*
+         * Ordinary wired/speaker route.  The WCD chain being live here is
+         * normal and must never be reported as an error.
+         */
+        if (lh->effective == LEO_HIFI_ACTIVE ||
+            lh->effective == LEO_HIFI_DEGRADED ||
+            lh->effective == LEO_HIFI_ARMING ||
+            lh->effective == LEO_HIFI_ERROR_FALLBACK) {
+            lh->generation++;
+            lh->evidence = 0;
+            lh->bypass = 0;
+            lh->effective = LEO_HIFI_WIRED_STANDARD;
+            ALOGI("%s: gen=%llu -> wired_standard", __func__, lh->generation);
+        }
+        return;
+    }
+
+    lh->generation++;
+    lh->evidence = 0;
+    lh->bypass = 0;
+    if (lh->vol_restore_pending && leo_hifi_restore_volume_floor(lh) != 0) {
+        lh->effective = LEO_HIFI_ERROR_FALLBACK;
+        return;
+    }
+    lh->fail_code = LEO_FAIL_NONE;
+    lh->effective = LEO_HIFI_ARMING;
+
+    lh->evidence |= LEO_EV_E2;
+    if (lh->supported)
+        lh->evidence |= LEO_EV_E3;   /* proven by the probe that let us here */
+    lh->evidence |= LEO_EV_E9;
+
+    /* E4: the mixer path really enabled a QUAT front end. */
+    if (leo_quat_front_end_live(lh))
+        lh->evidence |= LEO_EV_E4;
+    else
+        lh->fail_code = LEO_FAIL_QUAT_NOT_ROUTED;
+
+    /* E6: the backend was written before the route; confirm it stuck. */
+    if (leo_hifi_set_backend(lh) == 0)
+        lh->evidence |= LEO_EV_E6;
+
+    /* E7: the volume control must read back inside the allowed window. */
+    if (leo_hifi_read_volume(lh, vol) == 0 &&
+        vol[0] == vol[1] &&
+        vol[0] >= LEO_HIFI_CTL_FLOOR && vol[0] <= LEO_HIFI_CTL_CEIL)
+        lh->evidence |= LEO_EV_E7;
+
+    /* E5: the decisive one -- no complete WCD path to the jack. */
+    if (leo_hifi_check_bypass(lh))
+        lh->evidence |= LEO_EV_E5;
+
+    if ((lh->evidence & LEO_EV_FATAL_MASK) != LEO_EV_FATAL_MASK) {
+        leo_hifi_fallback(lh);
+        return;
+    }
+
+    if ((lh->evidence & LEO_EV_E7) == 0) {
+        lh->effective = LEO_HIFI_DEGRADED;
+        ALOGW("%s: gen=%llu evidence=0x%x bypass=0x%x -> hifi_degraded",
+              __func__, lh->generation, lh->evidence, lh->bypass);
+        return;
+    }
+
+    lh->effective = LEO_HIFI_ACTIVE;
+    ALOGI("%s: gen=%llu evidence=0x%x bypass=0x%x -> hifi_active",
+          __func__, lh->generation, lh->evidence, lh->bypass);
+}
+
+void leo_hifi_on_route_off(struct leo_hifi *lh)
+{
+    int restored = 0;
+    if (lh->vol_applied || lh->vol_restore_pending)
+        restored = leo_hifi_restore_volume_floor(lh);
+    lh->generation++;
+    lh->evidence = 0;
+    pthread_mutex_lock(&lh->telemetry_lock);
+    leo_flow_reset(&lh->flow);
+    pthread_mutex_unlock(&lh->telemetry_lock);
+    lh->bypass = 0;
+    lh->effective = restored == 0 ? LEO_HIFI_IDLE : LEO_HIFI_ERROR_FALLBACK;
+    ALOGI("%s: gen=%llu -> idle", __func__, lh->generation);
+}
+
+static void leo_hifi_eval_state(struct leo_hifi *lh, bool *out_live, bool *out_flow) {
+    *out_live = false;
+    *out_flow = false;
+    if (!lh->supported || !lh->requested || lh->vol_restore_pending || lh->effective != LEO_HIFI_ACTIVE || lh->fail_code != LEO_FAIL_NONE || !leo_ess_bound())
+        return;
+        
+    int vol0 = -1, vol1 = -1;
+    if (lh->ctl_volume != NULL) {
+        vol0 = mixer_ctl_get_value(lh->ctl_volume, 0);
+        vol1 = mixer_ctl_get_value(lh->ctl_volume, 1);
+    }
+    
+    bool quat_on = lh->ctl_quat_mm[0] && mixer_ctl_get_value(lh->ctl_quat_mm[0], 0) == 1;
+    bool dac_off = lh->ctl_hphl_dac && mixer_ctl_get_value(lh->ctl_hphl_dac, 0) == 0;
+    bool backend_ok = false;
+    if (lh->ctl_quat_bw && lh->ctl_quat_sr) {
+        int v_bw = mixer_ctl_get_value(lh->ctl_quat_bw, 0);
+        const char *s_bw = (v_bw >= 0) ? mixer_ctl_get_enum_string(lh->ctl_quat_bw, v_bw) : NULL;
+        int v_sr = mixer_ctl_get_value(lh->ctl_quat_sr, 0);
+        const char *s_sr = (v_sr >= 0) ? mixer_ctl_get_enum_string(lh->ctl_quat_sr, v_sr) : NULL;
+        if (s_bw && strcmp(s_bw, LEO_HIFI_BITWIDTH_STR) == 0 &&
+            s_sr && strcmp(s_sr, LEO_HIFI_SAMPLERATE_STR) == 0) {
+            backend_ok = true;
+        }
+    }
+    
+    if (quat_on && dac_off && backend_ok && vol0 >= LEO_HIFI_CTL_FLOOR && vol0 <= LEO_HIFI_CTL_CEIL && vol0 == vol1) {
+        *out_live = true;
+    }
+    
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) == 0) {
+        int64_t ms = (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+        pthread_mutex_lock(&lh->telemetry_lock);
+        *out_flow = *out_live && leo_flow_live(&lh->flow, ms);
+        pthread_mutex_unlock(&lh->telemetry_lock);
+    }
+}
+
+static bool parse_uint63(const char *str, unsigned long long *out) {
+    if (!str || !*str) return false;
+    unsigned long long val = 0;
+    for (int i = 0; str[i]; i++) {
+        if (str[i] < '0' || str[i] > '9') return false;
+        unsigned int digit = (unsigned int)(str[i] - '0');
+        if (val > (9223372036854775807ULL - digit) / 10ULL) return false;
+        val = val * 10ULL + digit;
+    }
+    if (val > 9223372036854775807ULL) return false;
+    *out = val;
+    return true;
+}
+
+int leo_hifi_process_request(struct leo_hifi *lh, const char *mode_str, const char *vol_str, const char *sess_str, const char *gen_str, bool *mode_changed) {
+    if (mode_changed) *mode_changed = false;
+    if (!lh) return -EINVAL;
+    /* Caller holds adev->lock across validation, mutation and route selection. */
+    if (!mode_str && !vol_str) return -EINVAL;
+    if (mode_str && vol_str) return -EINVAL;
+    if (!sess_str || !gen_str) return -EINVAL;
+    
+    unsigned long long session, gen;
+    if (!parse_uint63(sess_str, &session) || session == 0) return -EINVAL;
+    if (!parse_uint63(gen_str, &gen)) return -EINVAL;
+    
+    int vol_val = 0;
+    bool mode_val = false;
+    
+    if (vol_str) {
+        if (vol_str[0] == '0' && vol_str[1] != '\0') return -EINVAL;
+        unsigned long long v;
+        if (!parse_uint63(vol_str, &v) || v > 60) return -EINVAL;
+        vol_val = (int)v;
+    }
+    
+    if (mode_str) {
+        if (strcmp(mode_str, "true") == 0) mode_val = true;
+        else if (strcmp(mode_str, "false") == 0) mode_val = false;
+        else return -EINVAL;
+    }
+    
+    pthread_mutex_lock(&lh->telemetry_lock);
+    unsigned long long current_session = lh->session;
+    pthread_mutex_unlock(&lh->telemetry_lock);
+    
+    if (session != current_session || gen != lh->generation) return -EAGAIN;
+    
+    if (vol_str) {
+        bool is_live, flow_active;
+        if (!lh->requested || lh->effective != LEO_HIFI_ACTIVE || lh->fail_code != LEO_FAIL_NONE) return -EAGAIN;
+        leo_hifi_eval_state(lh, &is_live, &flow_active);
+        if (!flow_active) return -EAGAIN;
+        
+        int ret = leo_hifi_apply_volume(lh, vol_val);
+        return (ret == 0) ? 0 : ret;
+    }
+    
+    if (mode_str) {
+        if (leo_hifi_set_mode(lh, mode_val)) {
+            if (mode_changed) *mode_changed = true;
+        }
+        return 0;
+    }
+    
+    return -EINVAL;
+}
+
+int leo_hifi_status_string(struct leo_hifi *lh, char *buf, size_t len)
+{
+    const char *sign = "";
+    int vol0 = -1, vol1 = -1, whole = 0, tenth = 0;
+    bool is_live = false, flow_active = false;
+    const char *backend_str = "unconfirmed";
+    unsigned long long current_session = 0;
+    int v_bw = -1, v_sr = -1;
+    const char *s_bw = NULL, *s_sr = NULL;
+
+    if (lh->supported && lh->ctl_volume != NULL) {
+        vol0 = mixer_ctl_get_value(lh->ctl_volume, 0);
+        vol1 = mixer_ctl_get_value(lh->ctl_volume, 1);
+    }
+    if (vol0 >= 0)
+        leo_hifi_ctl_to_db(vol0, &sign, &whole, &tenth);
+
+    if (lh->ctl_quat_bw && lh->ctl_quat_sr) {
+        v_bw = mixer_ctl_get_value(lh->ctl_quat_bw, 0);
+        s_bw = (v_bw >= 0) ? mixer_ctl_get_enum_string(lh->ctl_quat_bw, v_bw) : NULL;
+        v_sr = mixer_ctl_get_value(lh->ctl_quat_sr, 0);
+        s_sr = (v_sr >= 0) ? mixer_ctl_get_enum_string(lh->ctl_quat_sr, v_sr) : NULL;
+
+        if (s_bw && strcmp(s_bw, LEO_HIFI_BITWIDTH_STR) == 0 &&
+            s_sr && strcmp(s_sr, LEO_HIFI_SAMPLERATE_STR) == 0) {
+            backend_str = LEO_HIFI_BITWIDTH_STR "/" LEO_HIFI_SAMPLERATE_STR;
+        }
+    }
+
+    leo_hifi_eval_state(lh, &is_live, &flow_active);
+
+    pthread_mutex_lock(&lh->telemetry_lock);
+    current_session = lh->session;
+    pthread_mutex_unlock(&lh->telemetry_lock);
+
+    if (!buf || len == 0) return -EINVAL;
+    int n = snprintf(buf, len,
+             "schema:4,session:%llu,gen:%llu,supported:%d,requested:%s,"
+             "effective:%s,live:%d,flow:%d,vol_ctl_l:%d,vol_ctl_r:%d,"
+             "vol_db:%s%d.%d,vol_user:%d,backend:%s,fail:%d,"
+             "permanent_fail:%d,probes:%d,ev:0x%x,bypass:0x%x,vol_applied:%d,"
+             "restore_pending:%d,acdb:absent_expected",
+             current_session, lh->generation, lh->supported ? 1 : 0,
+             lh->requested ? "hifi" : "standard",
+             leo_state_name(lh->effective),
+             is_live ? 1 : 0, flow_active ? 1 : 0,
+             vol0, vol1, sign, whole, tenth, lh->vol_user,
+             backend_str, lh->fail_code,
+             lh->permanent_fail ? 1 : 0, lh->probe_attempts,
+             lh->evidence, lh->bypass, lh->vol_applied ? 1 : 0,
+             lh->vol_restore_pending ? 1 : 0);
+    if (n < 0 || (size_t)n >= len) {
+        buf[0] = '\0'; /* Never publish a truncated, partially valid status. */
+        return -ENOSPC;
+    }
+    return 0;
+}
+
+unsigned long long leo_hifi_flow_token(struct leo_hifi *lh)
+{
+    unsigned long long token;
+    pthread_mutex_lock(&lh->telemetry_lock);
+    token = lh->flow.token;
+    pthread_mutex_unlock(&lh->telemetry_lock);
+    return token;
+}
+
+void leo_hifi_note_frames(struct leo_hifi *lh, unsigned long long token,
+                         uintptr_t stream, uint64_t written, unsigned int size,
+                         unsigned int avail, bool valid)
+{
+    struct timespec now;
+    int64_t ms = -1;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) == 0)
+        ms = (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+    pthread_mutex_lock(&lh->telemetry_lock);
+    leo_flow_sample(&lh->flow, token, stream, written, size, avail, valid, ms);
+    pthread_mutex_unlock(&lh->telemetry_lock);
+}
+
+void leo_hifi_destroy(struct leo_hifi *lh)
+{
+    pthread_mutex_destroy(&lh->telemetry_lock);
+}
