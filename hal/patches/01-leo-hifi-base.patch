+
+/*
+ * Leo HiFi Controller -- Xiaomi Mi Note Pro (leo) only.
+ *
+ * Owns every write to the ESS9018K2M / QUAT_MI2S control surface.  Nothing
+ * else in the system (no app, no init script, no tinymix service) may write
+ * those controls.  See docs/19-PHASE-5B-M3-HIFI-CONTROLLER-CONTRACT.md.
+ *
+ * Default state is DISABLED: with vendor.leo.audio.hifi.enable unset the
+ * device behaves exactly like stock MoKee.
+ */
+
+#ifndef LEO_HIFI_H
+#define LEO_HIFI_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <time.h>
+#include <stdint.h>
+#include "leo_hifi_flow.h"
+#include <pthread.h>
+#include <tinyalsa/asoundlib.h>
+
+/* mixer_paths.xml path suffix; must equal device_table[SND_DEVICE_OUT_LEO_HIFI_HEADPHONES] */
+#define LEO_HIFI_DEVICE_NAME        "hifi-headphones"
+#define LEO_HIFI_HW_INTERFACE       "QUAT_MI2S_RX"
+
+#define LEO_PROP_ENABLE             "vendor.leo.audio.hifi.enable"
+#define LEO_PROP_VOLUME             "vendor.leo.audio.hifi.volume"
+#define LEO_PROP_SUPPORTED          "vendor.leo.audio.hifi.supported"
+
+#define LEO_PARAM_KEY_MODE          "leo_hifi_mode"
+#define LEO_PARAM_KEY_VOLUME        "leo_hifi_volume"
+#define LEO_PARAM_KEY_STATUS        "leo_hifi_status"
+
+/*
+ * ES9018 "Volume" kcontrol, read out of the MoKee boot kernel image
+ * (snd_kcontrol_new -> soc_mixer_control + TLV):
+ *
+ *   min = 0, max = 255, reg = 15, rreg = 16, invert = 1
+ *   TLV = DB_SCALE(min = -127.50 dB, step = 0.50 dB)
+ *   => dB = -127.50 + 0.50 * ctl_value, higher control value == louder
+ *
+ * 205 is the mixer_paths.xml default (-25.0 dB) and is our absolute floor.
+ */
+#define LEO_HIFI_CTL_FLOOR          205     /* -25.0 dB, mixer_paths.xml default */
+#define LEO_HIFI_CTL_BASE           213     /* user 0   -> -21.0 dB              */
+#define LEO_HIFI_CTL_CEIL           237     /* user 60  ->  -9.0 dB, stage-1 cap */
+#define LEO_HIFI_VOL_MAX            60      /* user scale cap before R6/R7       */
+#define LEO_HIFI_VOL_STEP_MAX       5       /* max user units applied per frame  */
+
+/* Number of MultiMedia front ends to scan on both backends. */
+#define LEO_HIFI_MM_COUNT           16
+
+/*
+ * Bounded late re-probe.
+ *
+ * A single transient failure at platform_init() time (sound card registered
+ * before the ES9018 codec component bound, sysfs not yet populated) must not
+ * cost HiFi for the whole boot.  The probe is strictly read-only -- a stat()
+ * plus a handful of mixer_get_ctl_by_name() calls -- so retrying cannot pop,
+ * cannot re-route and costs no power.  A structural failure (device_table
+ * mismatch) is NOT retried: it can never fix itself and acting on it would
+ * mean writing to an unknown device.
+ */
+#define LEO_HIFI_PROBE_MAX          3
+
+typedef enum {
+    LEO_HIFI_IDLE = 0,
+    LEO_HIFI_SPEAKER,
+    LEO_HIFI_WIRED_STANDARD,
+    LEO_HIFI_ARMING,
+    LEO_HIFI_ACTIVE,
+    LEO_HIFI_DEGRADED,
+    LEO_HIFI_ERROR_FALLBACK,
+} leo_hifi_state_t;
+
+/* fail codes -- see docs/19 section 4.3 */
+enum {
+    LEO_FAIL_NONE             = 0,
+    LEO_FAIL_CTL_MISSING      = 1,
+    LEO_FAIL_CTL_WRITE        = 2,
+    LEO_FAIL_READBACK_FATAL   = 3,
+    LEO_FAIL_READBACK_SOFT    = 4,
+    LEO_FAIL_ESS_UNBOUND      = 5,
+    LEO_FAIL_WCD_BYPASS       = 6,
+    LEO_FAIL_BACKEND_RATE     = 7,
+    LEO_FAIL_TIMEOUT          = 8,
+    LEO_FAIL_VOL_RANGE        = 9,
+    LEO_FAIL_BACKEND_READBACK = 10,
+    LEO_FAIL_USECASE_UNKNOWN  = 11,
+    LEO_FAIL_TABLE_MISMATCH   = 12,
+    LEO_FAIL_QUAT_NOT_ROUTED  = 13,
+};
+
+struct leo_hifi {
+    bool                supported;      /* probe passed; controls resolved       */
+    bool                permanent_fail;  /* structural: never retry              */
+    int                 probe_attempts;
+    bool                requested;      /* policy intent (leo_hifi_mode)         */
+    leo_hifi_state_t    effective;      /* only advanced after read-back         */
+    unsigned long long  generation;
+    int                 fail_code;
+    unsigned int        evidence;       /* LEO_EV_* bitmap                       */
+    unsigned int        bypass;         /* LEO_BP_* bitmap, last observation     */
+
+    pthread_mutex_t     telemetry_lock;
+    unsigned long long  session;
+    struct leo_hifi_flow flow;
+
+    int                 vol_user;       /* 0..LEO_HIFI_VOL_MAX                   */
+    bool                vol_applied;    /* false until we have written "Volume"  */
+    bool                vol_restore_pending; /* only clear after verified 205/205 */
+
+    const char         *device_name;    /* device_table entry, for the self-check */
+    struct mixer       *mixer;
+    struct mixer_ctl   *ctl_volume;
+    struct mixer_ctl   *ctl_quat_bw;
+    struct mixer_ctl   *ctl_quat_sr;
+    struct mixer_ctl   *ctl_hphl_dac;
+    struct mixer_ctl   *ctl_slim_rx1_mux;
+    struct mixer_ctl   *ctl_slim_rx2_mux;
+    struct mixer_ctl   *ctl_rx1_mix1_inp1;
+    struct mixer_ctl   *ctl_rx2_mix1_inp1;
+    struct mixer_ctl   *ctl_class_h_mux;
+    struct mixer_ctl   *ctl_slim_mm[LEO_HIFI_MM_COUNT];
+    struct mixer_ctl   *ctl_quat_mm[LEO_HIFI_MM_COUNT];
+};
+
+/*
+ * Resolve every control we will ever touch and run the device_table
+ * self-check. After a successful probe, verify/recover the factory volume;
+ * saved user gain is never replayed. Never fails the caller: platform_init() must keep working on a
+ * device without an ES9018, and a failure here must never block Android boot
+ * or ordinary headphone playback.
+ */
+void leo_hifi_init(struct leo_hifi *lh, struct mixer *mixer,
+                   const char *device_table_name);
+
+/*
+ * True when the controller may select the HiFi output device.  Not const:
+ * when the intent is set but a previous probe failed transiently this performs
+ * one bounded, read-only re-probe (at most LEO_HIFI_PROBE_MAX per boot).
+ * Successful late binding or pending volume recovery also verifies/restores
+ * the factory floor before route selection. Caller must hold adev->lock.
+ */
+bool leo_hifi_route_wanted(struct leo_hifi *lh);
+
+/*
+ * Apply a new policy intent.  Returns true when the intent actually changed
+ * and the caller must re-run select_devices() for active playback usecases.
+ */
+bool leo_hifi_set_mode(struct leo_hifi *lh, bool enable);
+
+/* ---------------------------------------------------------------------- *
+ * Independent HiFi volume (ES9018 "Volume" kcontrol)
+ * ---------------------------------------------------------------------- */
+
+/* ctl = LEO_HIFI_CTL_BASE + (user * 2) / 5   =>   dB = -21.0 + 0.2 * user */
+static inline int leo_hifi_user_to_ctl(int user)
+{
+    return LEO_HIFI_CTL_BASE + (user * 2) / 5;
+}
+
+/*
+ * Exact, sign-safe dB decomposition.  dB = -127.50 + 0.50 * v, so the value in
+ * tenths of a dB is exactly (5 * v - 1275).  Everything is integer: C division
+ * truncates toward zero, which silently drops the sign for values in
+ * (-1.0, 0.0), so the sign is carried separately instead of being derived from
+ * the quotient.  Print with "%s%d.%d" and the returned sign string.
+ */
+void leo_hifi_ctl_to_db(int ctl_value, const char **sign, int *whole, int *tenth);
+
+/*
+ * Read the current control value into out[2].  Returns 0 on success.
+ * Never writes anything.
+ */
+int leo_hifi_read_volume(struct leo_hifi *lh, int out[2]);
+
+/*
+ * Clamp, apply and read back.  Returns 0 on success, -EINVAL when the
+ * request is out of range (fail_code LEO_FAIL_VOL_RANGE, value unchanged),
+ * -EIO when the write or readback fails. Recovery to LEO_HIFI_CTL_FLOOR is
+ * attempted; vol_restore_pending remains true if it cannot be confirmed.
+ *
+ * Large jumps are split into bounded frames; the ES9018 has its own
+ * "Volume Ramp Rate" but we do not rely on it alone.
+ */
+int leo_hifi_apply_volume(struct leo_hifi *lh, int user_vol);
+
+/* Verify/restore 205/205. Never clear vol_restore_pending on an unproven write. */
+int leo_hifi_restore_volume_floor(struct leo_hifi *lh);
+
+/* ---------------------------------------------------------------------- *
+ * Deterministic QUAT_MI2S backend
+ * ---------------------------------------------------------------------- */
+
+/*
+ * Stage-1 targets.  M3 pins the backend at the 48 kHz clock family; 44.1 kHz
+ * is M3.5 and must not be attempted here.  "Leaving the control alone" is NOT
+ * equivalent to "correct": upstream has no teardown reset for these controls,
+ * so a previous non-48 kHz session can leave a stale value behind.
+ *
+ * Nothing else in the HAL writes QUAT_MI2S BitWidth / SampleRate (verified by
+ * grep over the whole hardware/qcom-caf/msm8994/audio tree at 7f4cac74), and
+ * the kernel machine driver samples both kcontrols at hw_params time, i.e.
+ * when the QUAT DAI starts.  The write must therefore happen BEFORE the mixer
+ * path that enables QUAT_MI2S_RX is applied.
+ */
+#define LEO_HIFI_BITWIDTH_STR       "S24_LE"
+#define LEO_HIFI_SAMPLERATE_STR     "KHZ_48"
+
+/*
+ * Write BitWidth then SampleRate and read both back.  Returns 0 only when
+ * both read-backs match.  Idempotent, so repeated calls across several
+ * usecases on the same device are harmless.
+ */
+int leo_hifi_set_backend(struct leo_hifi *lh);
+
+/*
+ * Entry hook, called from enable_snd_device() with the NEW device.
+ *
+ * It must not be called from platform_check_and_set_codec_backend_cfg():
+ * at that point select_devices() has not yet assigned usecase->out_snd_device,
+ * so the usecase still carries the PREVIOUS device and the guard would test
+ * the wrong edge.
+ */
+void platform_leo_hifi_snd_device_enabled(void *platform, int snd_device);
+
+/* Exit-side hook called from disable_audio_route(); never blocks teardown. */
+void platform_leo_hifi_backend_exit(void *platform, int snd_device);
+
+/* ---------------------------------------------------------------------- *
+ * WCD bypass detection, state machine and read-only status
+ * ---------------------------------------------------------------------- */
+
+/* Evidence bits, mirrored into the leo_hifi_status string. */
+#define LEO_EV_E2       (1u << 1)   /* HiFi snd_device selected               */
+#define LEO_EV_E3       (1u << 2)   /* ES9018 bound on I2C 6-0048             */
+#define LEO_EV_E4       (1u << 3)   /* a QUAT_MI2S_RX front end is On         */
+#define LEO_EV_E5       (1u << 4)   /* no complete WCD path to the jack       */
+#define LEO_EV_E6       (1u << 5)   /* QUAT backend read back as targeted     */
+#define LEO_EV_E7       (1u << 6)   /* ES9018 Volume read back as expected    */
+#define LEO_EV_E9       (1u << 7)   /* no control write failure this gen      */
+
+#define LEO_EV_FATAL_MASK \
+    (LEO_EV_E2 | LEO_EV_E3 | LEO_EV_E4 | LEO_EV_E5 | LEO_EV_E6 | LEO_EV_E9)
+
+/*
+ * Bypass observation bits.  These describe the WCD9330 chain
+ *   MultiMediaN -> SLIMBUS_0_RX -> SLIM RXn MUX -> RXn MIX1 INP1
+ *                -> CLASS_H_DSM MUX -> HPHL DAC Switch -> jack
+ * Only LEO_BP_OUTLET is fatal on its own: M2 proved on the real device that
+ * cutting the analog outlet silences the WCD path even while
+ * SLIMBUS_0_RX <- MultiMedia5 is still On.  Everything else is recorded as a
+ * bypass *attempt*, which is diagnostic, not proof of audible sound.
+ */
+#define LEO_BP_SLIM_FE  (1u << 0)   /* some SLIMBUS_0_RX <- MultiMediaN On    */
+#define LEO_BP_MUX_LIVE (1u << 1)   /* SLIM RX1 or RX2 MUX != ZERO            */
+#define LEO_BP_MIX_LIVE (1u << 2)   /* RX1 or RX2 MIX1 INP1 != ZERO           */
+#define LEO_BP_CLASSH   (1u << 3)   /* CLASS_H_DSM MUX != ZERO                */
+#define LEO_BP_OUTLET   (1u << 4)   /* HPHL DAC Switch On -- FATAL            */
+
+#define LEO_BP_FATAL_MASK   (LEO_BP_OUTLET)
+
+/*
+ * Observe the WCD chain.  Returns true when no FATAL bypass condition is
+ * present.  Always fills lh->bypass with everything it saw, so a non-fatal
+ * "bypass attempt" is visible in the status string without changing state.
+ *
+ * This is only meaningful while the HiFi device is selected.  In the ordinary
+ * WIRED_STANDARD case the WCD chain is supposed to be live, and the state
+ * machine does not call this at all.
+ */
+bool leo_hifi_check_bypass(struct leo_hifi *lh);
+
+/*
+ * State machine entry points.  leo_hifi_on_route() runs the full read-back
+ * sequence and decides between HIFI_ACTIVE, HIFI_DEGRADED and
+ * ERROR_FALLBACK; it never advances to HIFI_ACTIVE on stale evidence because
+ * every call starts a new generation and re-reads everything.
+ */
+void leo_hifi_on_route(struct leo_hifi *lh, bool to_hifi_device);
+void leo_hifi_on_route_off(struct leo_hifi *lh);
+
+/* Render the read-only status snapshot into buf (never fails). */
+/* Schema4 inner payload; return 0 only for complete output, otherwise empty. */
+int leo_hifi_status_string(struct leo_hifi *lh, char *buf, size_t len);
+
+int leo_hifi_process_request(struct leo_hifi *lh, const char *mode_str, const char *vol_str, const char *sess_str, const char *gen_str, bool *mode_changed);
+
+/* Thin wrappers defined in platform.c and called from audio_hw.c. */
+void platform_leo_hifi_route_enabled(void *platform, int snd_device);
+void platform_leo_hifi_route_disabled(void *platform, int snd_device);
+unsigned long long platform_leo_hifi_flow_token(void *platform);
+void platform_leo_hifi_note_frames(void *platform, unsigned long long token,
+                                  uintptr_t stream, uint64_t written,
+                                  unsigned int size, unsigned int avail, bool valid);
+
+unsigned long long leo_hifi_flow_token(struct leo_hifi *lh);
+void leo_hifi_note_frames(struct leo_hifi *lh, unsigned long long token,
+                         uintptr_t stream, uint64_t written, unsigned int size,
+                         unsigned int avail, bool valid);
+void leo_hifi_destroy(struct leo_hifi *lh);
+
+#endif /* LEO_HIFI_H */
diff --git a/hal/msm8974/leo_hifi_flow.h b/hal/msm8974/leo_hifi_flow.h
new file mode 100644
index 0000000..70afd8e
--- /dev/null
+++ b/hal/msm8974/leo_hifi_flow.h
@@ -0,0 +1,46 @@
+#ifndef LEO_HIFI_FLOW_H
+#define LEO_HIFI_FLOW_H
+#include <stdint.h>
+#include <stdbool.h>
+/* Caller owns the telemetry mutex. No mixer access and no stream/adev lock acquisition. */
+struct leo_hifi_flow {
+    uint64_t token, presented;
+    uintptr_t stream;
+    int64_t observed_ms;
+    unsigned int advances;
+    bool valid;
+};
+static inline void leo_flow_reset(struct leo_hifi_flow *f)
+{
+    f->token++;
+    if (f->token == 0) f->token = 1;
+    f->valid = false;
+    f->advances = 0;
+}
+static inline bool leo_flow_live(const struct leo_hifi_flow *f, int64_t now)
+{
+    return f->valid && f->advances >= 2 && now >= f->observed_ms
+        && now - f->observed_ms <= 2000;
+}
+static inline void leo_flow_sample(struct leo_hifi_flow *f, uint64_t token,
+        uintptr_t stream, uint64_t written, unsigned int size, unsigned int avail,
+        bool valid, int64_t now)
+{
+    uint64_t presented;
+    if (token != f->token || token == 0) return; /* old route cannot update the new one */
+    if (!valid || now < 0 || size == 0 || avail > size || written < size - avail) {
+        f->valid = false; f->advances = 0; return;
+    }
+    presented = written - (size - avail);
+    if (!f->valid || stream != f->stream || presented < f->presented
+            || now < f->observed_ms || now - f->observed_ms > 2000) {
+        f->advances = 0;
+    } else if (presented > f->presented) {
+        if (f->advances < 2) f->advances++;
+    } else {
+        f->advances = 0;
+    }
+    f->valid = true; f->presented = presented; f->stream = stream;
+    f->observed_ms = now;
+}
+#endif
