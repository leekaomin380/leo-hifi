+int leo_hifi_set_hardvol(struct leo_hifi *lh, const char *val_str, const char *sess_str)
+{
+    unsigned long long session, current;
+    bool on;
+    if (!lh || !val_str) return -EINVAL;
+    if (strcmp(val_str, "0") == 0) on = false;
+    else if (strcmp(val_str, "1") == 0) on = true;
+    else return -EINVAL;
+    if (on) {
+        /* Arming needs a live session and a supported controller. */
+        if (!sess_str || !parse_uint63(sess_str, &session) || session == 0) return -EINVAL;
+        pthread_mutex_lock(&lh->telemetry_lock);
+        current = lh->session;
+        pthread_mutex_unlock(&lh->telemetry_lock);
+        if (session != current || !lh->supported) return -EAGAIN;
+    }
+    /* Disarming is always allowed: it can only make the standard path audible
+     * again, and the app restores Android volume before it disarms. */
+    lh->hardvol = on;
+    (void) property_set(LEO_PROP_HARDVOL, on ? "1" : "0");
+    ALOGI("%s: hardvol=%d", __func__, on ? 1 : 0);
+    return 0;
+}
