diff --git a/hal/msm8974/leo_hifi.c b/hal/msm8974/leo_hifi.c
index 57606ee..a3c010a 100644
--- a/hal/msm8974/leo_hifi.c
+++ b/hal/msm8974/leo_hifi.c
@@ -426,6 +426,8 @@ int leo_hifi_set_backend(struct leo_hifi *lh)
 {
     int ret;
 
+    lh->backend_config_failed = true;
+
     if (!lh->supported)
         return -ENODEV;
 
@@ -434,8 +436,175 @@ int leo_hifi_set_backend(struct leo_hifi *lh)
     if (ret != 0)
         return ret;
 
-    return leo_set_enum_checked(lh, lh->ctl_quat_sr, "QUAT_MI2S SampleRate",
-                                LEO_HIFI_SAMPLERATE_STR);
+    ret = leo_set_enum_checked(lh, lh->ctl_quat_sr, "QUAT_MI2S SampleRate",
+                               LEO_HIFI_SAMPLERATE_STR);
+    if (ret == 0)
+        lh->backend_config_failed = false;
+    return ret;
+}
+
+/* A route that is already running must never repair its shared clock. */
+static bool leo_hifi_backend_valid(struct leo_hifi *lh)
+{
+    int bw, sr;
+    const char *width, *rate;
+    if (!lh->supported || lh->backend_config_failed || !lh->ctl_quat_bw || !lh->ctl_quat_sr)
+        return false;
+    bw = mixer_ctl_get_value(lh->ctl_quat_bw, 0);
+    sr = mixer_ctl_get_value(lh->ctl_quat_sr, 0);
+    width = bw >= 0 ? mixer_ctl_get_enum_string(lh->ctl_quat_bw, bw) : NULL;
+    rate = sr >= 0 ? mixer_ctl_get_enum_string(lh->ctl_quat_sr, sr) : NULL;
+    return width && rate && strcmp(width, LEO_HIFI_BITWIDTH_STR) == 0 &&
+            strcmp(rate, LEO_HIFI_SAMPLERATE_STR) == 0;
+}
+
+static bool leo_hifi_frontends_closed(struct leo_hifi *lh)
+{
+    static const char * const links[] = {
+        "QUAT_MI2S_RX_Voice Mixer Voice Stub",
+        "Voice Stub Tx Mixer QUAT_MI2S_TX",
+        "QUAT_MI2S_RX_Voice Mixer VoLTE Stub",
+        "VoLTE Stub Tx Mixer QUAT_MI2S_TX",
+        "QUAT_MI2S_RX_Voice Mixer Voice2 Stub",
+        "Voice2 Stub Tx Mixer QUAT_MI2S_TX",
+        "QUAT_MI2S_RX Port Mixer PRI_MI2S_TX",
+        "PRI_MI2S_RX Port Mixer QUAT_MI2S_TX",
+    };
+    char name[64];
+    struct mixer_ctl *ctl;
+    int i;
+    for (i = 0; i < LEO_HIFI_MM_COUNT; ++i) {
+        /* Probe records absent controls (e.g. MM9) as NULL. A present control
+         * that cannot be read is unknown, never proof of a closed path. */
+        snprintf(name, sizeof(name), "QUAT_MI2S_RX Audio Mixer MultiMedia%d", i + 1);
+        ctl = mixer_get_ctl_by_name(lh->mixer, name);
+        if (ctl && mixer_ctl_get_value(ctl, 0) != 0)
+            return false;
+    }
+    /* The common I2S configuration also has voice and port connections.
+     * Resolve afresh so a late-exposed control cannot be mistaken for Off. */
+    for (i = 0; i < (int)(sizeof(links) / sizeof(links[0])); ++i) {
+        ctl = mixer_get_ctl_by_name(lh->mixer, links[i]);
+        if (ctl && mixer_ctl_get_value(ctl, 0) != 0)
+            return false;
+    }
+    return true;
+}
+
+int leo_hifi_prepare_backend(struct leo_hifi *lh, bool devices_busy)
+{
+    if (lh->route_count || devices_busy || !leo_hifi_frontends_closed(lh))
+        return leo_hifi_backend_valid(lh) ? 0 : -EBUSY;
+    lh->backend_restore_pending = true;
+    return leo_hifi_set_backend(lh);
+}
+
+int leo_hifi_finish_backend(struct leo_hifi *lh, bool devices_busy)
+{
+    int ret;
+    if (!lh->backend_restore_pending)
+        return 0;
+    if (lh->route_count || devices_busy || !leo_hifi_frontends_closed(lh))
+        return -EBUSY;
+    ret = leo_hifi_set_backend(lh);
+    if (ret != 0)
+        return ret;
+    lh->backend_restore_pending = false;
+    leo_hifi_on_route_off(lh);
+    return 0;
+}
+
+static struct leo_hifi_route *leo_hifi_find_route(struct leo_hifi *lh, int usecase)
+{
+    int i;
+    for (i = 0; i < LEO_HIFI_ROUTE_MAX; ++i)
+        if (lh->routes[i].active && lh->routes[i].usecase == usecase)
+            return &lh->routes[i];
+    return NULL;
+}
+
+int leo_hifi_route_prepare(struct leo_hifi *lh, int usecase, uintptr_t stream)
+{
+    struct leo_hifi_route *route = leo_hifi_find_route(lh, usecase);
+    lh->route_ownership = true;
+    if (route)
+        return route->stream == stream ? 1 : -EEXIST;
+    if (lh->route_count >= LEO_HIFI_ROUTE_MAX)
+        return -ENOSPC;
+    return leo_hifi_backend_valid(lh) ? 0 : -EIO;
+}
+
+int leo_hifi_route_enable(struct leo_hifi *lh, int usecase, int mm,
+                          uintptr_t stream, bool music, bool hifi)
+{
+    int i, ret = leo_hifi_route_prepare(lh, usecase, stream);
+    struct leo_hifi_route *route;
+    if (ret != 0)
+        return ret == 1 ? 0 : ret;
+    /* Never borrow another usecase's live MM control as entry evidence. */
+    if (mm < 1 || mm > LEO_HIFI_MM_COUNT || !lh->ctl_quat_mm[mm - 1] ||
+        mixer_ctl_get_value(lh->ctl_quat_mm[mm - 1], 0) != 1)
+        return -EIO;
+    if (hifi) {
+        if (lh->hifi_route_count == 0) {
+            leo_hifi_on_route(lh, true);
+            if (lh->effective != LEO_HIFI_ACTIVE && lh->effective != LEO_HIFI_DEGRADED)
+                return -EIO;
+        } else if (!leo_hifi_check_bypass(lh)) {
+            /* Shared evidence has failed. Report it, without clock writes. */
+            lh->effective = LEO_HIFI_ERROR_FALLBACK;
+            return -EIO;
+        }
+    }
+    for (i = 0; i < LEO_HIFI_ROUTE_MAX && lh->routes[i].active; ++i) {}
+    route = &lh->routes[i];
+    route->active = true;
+    route->usecase = usecase;
+    route->mm = mm;
+    route->stream = stream;
+    route->music = music;
+    route->hifi = hifi;
+    lh->route_count++;
+    if (hifi)
+        lh->hifi_route_count++;
+    if (music && hifi) {
+        pthread_mutex_lock(&lh->telemetry_lock);
+        if (lh->flow_owner != stream) {
+            leo_flow_reset(&lh->flow);
+            lh->flow_owner = stream;
+            /* on_route() already advances the first HiFi route generation. */
+            if (lh->hifi_route_count > 1)
+                lh->generation++;
+        }
+        pthread_mutex_unlock(&lh->telemetry_lock);
+    }
+    return 0;
+}
+
+int leo_hifi_route_disable(struct leo_hifi *lh, int usecase)
+{
+    struct leo_hifi_route *route = leo_hifi_find_route(lh, usecase);
+    if (!route)
+        return 0;
+    /* The caller already reset this frontend path. Keep ownership on an
+     * unproven close so no subsequent teardown can rewrite a live clock. */
+    if (!lh->ctl_quat_mm[route->mm - 1] ||
+        mixer_ctl_get_value(lh->ctl_quat_mm[route->mm - 1], 0) != 0)
+        return -EIO;
+    if (route->music && route->hifi) {
+        pthread_mutex_lock(&lh->telemetry_lock);
+        if (lh->flow_owner == route->stream) {
+            lh->flow_owner = 0;
+            leo_flow_reset(&lh->flow);
+            lh->generation++;
+        }
+        pthread_mutex_unlock(&lh->telemetry_lock);
+    }
+    if (route->hifi)
+        lh->hifi_route_count--;
+    route->active = false;
+    lh->route_count--;
+    return 0;
 }
 
